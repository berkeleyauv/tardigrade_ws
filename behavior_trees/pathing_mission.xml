<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="TardigradePathingMission">
  <BehaviorTree ID="TardigradePathingMission">
    <ReactiveFallback name="mission_supervisor">
      <Sequence name="ABORT_IF_REQUESTED">
        <AbortRequested/>
        <StopMotion/>
        <DisarmRobot/>
        <ReportMissionResult result="aborted"/>
      </Sequence>
      <Sequence name="ROBOSUB_PATHING_MISSION">
        <Sequence name="01_PREFLIGHT_AND_ENABLE">
          <WaitForOperatorStart/>
          <RobotStatusHealthy/>
          <LocalizationHealthy max_odom_age_ms="250"/>
          <PerceptionHealthy/>
          <ExternalControlReady/>
          <SetExternalControl enabled="true"/>
          <WaitForExternalControl enabled="true"
                                  timeout_ms="3000"/>
          <WaitForArmed armed="true"
                        timeout_ms="3000"/>
          <SetArmed armed="true"/>
        </Sequence>
        <Sequence name="02_GATE_SEARCH_ALIGN_AND_PASS">
          <RetryUntilSuccessful name="spin_until_gate_visible"
                                num_attempts="-1">
            <Fallback name="gate_visible_or_spin_search">
              <GateVisible min_confidence="0.6"/>
              <ForceFailure>
                <Sequence name="spin_search_for_gate">
                  <SpinSearch yaw_rate_radps="0.25"/>
                  <Wait seconds="0.25"/>
                </Sequence>
              </ForceFailure>
            </Fallback>
          </RetryUntilSuccessful>
          <AlignWithGate alignment_tolerance_deg="5.0"/>
          <Fallback name="choose_gate_side">
            <Sequence name="use_operator_gate_side">
              <OperatorGateSideAvailable/>
              <UseOperatorGateSide side="{gate_side}"/>
            </Sequence>
            <SelectGateSideFromVision preferred_side="survey_and_repair"
                                      fallback_side="search_and_rescue"
                                      side="{gate_side}"/>
          </Fallback>
          <PassThroughGate side="{gate_side}"
                           distance_m="3.0"/>
          <ClearGate distance_m="2.0"/>
        </Sequence>
        <Sequence name="03_SLALOM_MARKER_1_LEFT_SIDE">
          <AlignWithSlalomLeftSide marker_index="1"
                                   lateral_offset_m="0.75"
                                   alignment_tolerance_deg="5.0"/>
          <RetryUntilSuccessful name="marker_1_until_visible"
                                num_attempts="-1">
            <Fallback name="marker_1_visible_or_search">
              <SlalomMarkerVisible marker_index="1"
                                   min_confidence="0.5"/>
              <ForceFailure>
                <Sequence name="search_for_marker_1">
                  <SweepSearch pattern="short_yaw_sweep"/>
                  <Wait seconds="0.25"/>
                </Sequence>
              </ForceFailure>
            </Fallback>
          </RetryUntilSuccessful>
          <DrivePastSlalomMarker marker_index="1"
                                 side="left"
                                 forward_distance_m="2.5"/>
        </Sequence>
        <Sequence name="04_SLALOM_MARKER_2_LEFT_SIDE">
          <RetryUntilSuccessful name="marker_2_until_visible"
                                num_attempts="-1">
            <Fallback name="marker_2_visible_or_search">
              <SlalomMarkerVisible marker_index="2"
                                   min_confidence="0.5"/>
              <ForceFailure>
                <Sequence name="search_for_marker_2">
                  <SweepSearch pattern="short_yaw_sweep"/>
                  <Wait seconds="0.25"/>
                </Sequence>
              </ForceFailure>
            </Fallback>
          </RetryUntilSuccessful>
          <AlignWithSlalomLeftSide marker_index="2"
                                   lateral_offset_m="0.75"
                                   alignment_tolerance_deg="5.0"/>
          <DrivePastSlalomMarker marker_index="2"
                                 side="left"
                                 forward_distance_m="2.5"/>
        </Sequence>
        <Sequence name="05_SLALOM_MARKER_3_LEFT_SIDE">
          <RetryUntilSuccessful name="marker_3_until_visible"
                                num_attempts="-1">
            <Fallback name="marker_3_visible_or_search">
              <SlalomMarkerVisible marker_index="3"
                                   min_confidence="0.5"/>
              <ForceFailure>
                <Sequence name="search_for_marker_3">
                  <SweepSearch pattern="short_yaw_sweep"/>
                  <Wait seconds="0.25"/>
                </Sequence>
              </ForceFailure>
            </Fallback>
          </RetryUntilSuccessful>
          <AlignWithSlalomLeftSide marker_index="3"
                                   lateral_offset_m="0.75"
                                   alignment_tolerance_deg="5.0"/>
          <DrivePastSlalomMarker marker_index="3"
                                 side="left"
                                 forward_distance_m="2.5"/>
        </Sequence>
        <Sequence name="06_MISSION_COMPLETE">
          <StopMotion/>
          <SetExternalControl enabled="false"/>
          <DisarmRobot/>
          <ReportMissionResult result="success"/>
        </Sequence>
      </Sequence>
    </ReactiveFallback>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Condition ID="AbortRequested"/>
    <Action ID="AlignWithGate">
      <input_port name="alignment_tolerance_deg"/>
    </Action>
    <Action ID="AlignWithSlalomLeftSide">
      <input_port name="marker_index"/>
      <input_port name="lateral_offset_m"/>
      <input_port name="alignment_tolerance_deg"/>
    </Action>
    <Action ID="ClearGate">
      <input_port name="distance_m"/>
    </Action>
    <Action ID="DisarmRobot"/>
    <Action ID="DrivePastSlalomMarker">
      <input_port name="marker_index"/>
      <input_port name="side"/>
      <input_port name="forward_distance_m"/>
    </Action>
    <Condition ID="ExternalControlReady"/>
    <Condition ID="GateVisible">
      <input_port name="min_confidence"/>
    </Condition>
    <Condition ID="LocalizationHealthy">
      <input_port name="max_odom_age_ms"/>
    </Condition>
    <Condition ID="OperatorGateSideAvailable"/>
    <Action ID="PassThroughGate">
      <input_port name="side"/>
      <input_port name="distance_m"/>
    </Action>
    <Condition ID="PerceptionHealthy"/>
    <Action ID="ReportMissionResult">
      <input_port name="result"/>
    </Action>
    <Condition ID="RobotStatusHealthy"/>
    <Action ID="SelectGateSideFromVision">
      <input_port name="preferred_side"/>
      <input_port name="fallback_side"/>
      <output_port name="side"/>
    </Action>
    <Action ID="SetArmed">
      <input_port name="armed"/>
    </Action>
    <Action ID="SetExternalControl">
      <input_port name="enabled"/>
    </Action>
    <Condition ID="SlalomMarkerVisible">
      <input_port name="marker_index"/>
      <input_port name="min_confidence"/>
    </Condition>
    <Action ID="SpinSearch">
      <input_port name="yaw_rate_radps"/>
    </Action>
    <Action ID="StopMotion"/>
    <Action ID="SweepSearch">
      <input_port name="pattern"/>
    </Action>
    <Action ID="UseOperatorGateSide">
      <output_port name="side"/>
    </Action>
    <Action ID="Wait">
      <input_port name="seconds"/>
    </Action>
    <Condition ID="WaitForArmed">
      <input_port name="armed"/>
      <input_port name="timeout_ms"/>
    </Condition>
    <Condition ID="WaitForExternalControl">
      <input_port name="enabled"/>
      <input_port name="timeout_ms"/>
    </Condition>
    <Condition ID="WaitForOperatorStart"/>
  </TreeNodesModel>

</root>
