# Copy this file to /etc/tardigrade/prequal.env on the Jetson.
WORKSPACE=/home/auv/Developer/tardigrade_ws
IMAGE=tardigrade-foxy
NAME=tardigrade-prequal

# Always use stable paths from: ls -l /dev/serial/by-id/
ESP_PORT=/dev/serial/by-id/REPLACE_WITH_ESP_ID
VECTORNAV_PORT=/dev/serial/by-id/REPLACE_WITH_VECTORNAV_ID

# Leave true until the complete launch has passed on the robot without motion.
DRY_RUN=true
STARTUP_DELAY_SEC=60.0
FORWARD_COMMAND=0.20

# IMU-only mode cannot measure depth or distance. Calibrate these in water.
DESCENT_COMMAND=0.20
DESCENT_DURATION_SEC=8.0
OUTBOUND_DURATION_SEC=40.0
RETURN_DURATION_SEC=40.0

# Heading PD applied during descent, outbound travel, turn, and return.
YAW_KP=0.4
YAW_KD=0.1
MAX_YAW_COMMAND=0.20
