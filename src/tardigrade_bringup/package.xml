<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tardigrade_bringup</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="root@todo.todo">root</maintainer>
  <license>TODO: License declaration</license>

  <!-- Launch files here start nodes from these runtime packages. -->
  <depend>ament_index_python</depend>
  <depend>launch</depend>
  <depend>launch_xml</depend>
  <depend>launch_ros</depend>
  <depend>joy</depend>
  <depend>robot_localization</depend>
  <depend>tardigrade_esp</depend>
  <depend>tardigrade_mission</depend>
  <depend>rosbridge_server</depend>
  <depend>tardigrade_sim</depend>
  <depend>tardigrade_state_estimation</depend>
  <depend>tardigrade_teleop</depend>
  <depend>tf2_ros</depend>
  <depend>vectornav</depend>

  <!-- Hardware-only launch files may include zed_wrapper when the ZED SDK
       packages are built on the Jetson. Keep it out of the hard manifest deps
       so local and CI builds can skip those packages. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
